# Loaded by Vite only when running in "emulator" mode (npm run dev:emulators).
# Layers on top of your local .env — these two flags wire the app to the local
# Firebase Emulator Suite instead of real cloud Firebase. No secrets here, so
# this file is committed.
VITE_USE_FIREBASE=true
VITE_FIREBASE_EMULATORS=all
# Route the Social Share modal at local generateOgImage (port matches firebase.json).
VITE_OG_IMAGE_ENDPOINT=http://127.0.0.1:5076/grids-one/us-central1/generateOgImage
