{
  "name": "@grids/discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node lib/index.js",
    "dev": "tsc && node lib/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.0.1",
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^4.1.5"
  }
}
