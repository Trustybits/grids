# Maintenance mode trigger: true or false
# When in maintenance mode, all function invocations will result in a noop or 503 HTTP error
# When toggling maintenance mode, redeploy the functions with the .env.grids-one file changed
MAINTENANCE_MODE=false

# Comma-separated Firebase UIDs of internal/dev-team accounts whose activity
# should be excluded from Discord notifications. Optional — leave empty to
# suppress nothing (the default for open-source/emulator setups).
DEV_TEAM_USER_IDS=