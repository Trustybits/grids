{
  "name": "grids",
  "version": "0.24.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulator",
    "build:deps": "npm --prefix ../.. run build:web-deps",
    "build": "npm run build:deps && run-p type-check:only \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check:only": "vue-tsc --build --force",
    "type-check": "npm run build:deps && npm run type-check:only",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "suite:full": "npm run lint && npm run test:run && npm run build && echo \"Success!\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@griddle/vue": "^0.1.8",
    "@grids/contracts": "file:../../packages/contracts",
    "@grids/pro": "file:../../packages/pro",
    "@sparticuz/chromium-min": "^147.0.0",
    "@tiptap/core": "^2.27.1",
    "@tiptap/extension-color": "^2.27.1",
    "@tiptap/extension-font-family": "^2.27.1",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.1",
    "@tiptap/extension-task-list": "^2.27.1",
    "@tiptap/extension-text": "^2.27.1",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.1",
    "@tiptap/starter-kit": "^2.27.1",
    "@tiptap/vue-3": "^2.27.1",
    "bootstrap": "^5.3.3",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.4.2",
    "hash-wasm": "^4.12.0",
    "mapbox-gl": "^3.4.0",
    "marked": "^18.0.3",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^2.2.8",
    "posthog-js": "^1.331.0",
    "puppeteer-core": "^24.41.0",
    "sass": "^1.81.0",
    "sharp": "^0.34.5",
    "uuid": "^11.0.3",
    "vue": "^3.5.12",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
