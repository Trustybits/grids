{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "outDir": "./node_modules/.tmp/dist-test",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "noUnusedLocals": false,
    "allowJs": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/__tests__/**/*",
    "scripts/**/*",
    "test/**/*",
    "vitest.config.ts"
  ]
}
